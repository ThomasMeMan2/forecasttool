# Database Configuration
DATABASE_URL=postgresql://forecast_user:forecast_password@localhost:5432/forecast_studio

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings
APP_NAME=Forecast Studio
DEBUG=True
CORS_ORIGINS=["http://localhost:3000"]

# File Upload Settings
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
UPLOAD_DIR=./uploads

# Forecasting Settings
DEFAULT_FORECAST_HORIZON=12
DEFAULT_CONFIDENCE_LEVEL=90

# Phase 2: LLM Integration (Optional)
# Set ENABLE_LLM_INSIGHTS=True and provide API key to enable AI-powered insights
LLM_PROVIDER=template  # Options: 'openai', 'anthropic', 'ollama', 'template'
LLM_MODEL=gpt-4-turbo-preview
OPENAI_API_KEY=  # Your OpenAI API key
ANTHROPIC_API_KEY=  # Your Anthropic API key
OLLAMA_BASE_URL=http://localhost:11434  # For local Ollama models
ENABLE_LLM_INSIGHTS=False  # Set to True when API keys are configured
